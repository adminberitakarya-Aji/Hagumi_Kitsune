# HAGUMI apps/web — contoh environment (salin jadi .env.local lalu isi)
# Tanpa kedua nilai ini fitur online tetap NONAKTIF dengan mulus — game lokal utuh (DoD M8).

# URL proyek Supabase, contoh: https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Anon key dari Supabase Studio → Settings → API (AMAN dipakai di klien;
# service role key TIDAK PERNAH ada di aplikasi — hanya di edge function)
VITE_SUPABASE_ANON_KEY=
